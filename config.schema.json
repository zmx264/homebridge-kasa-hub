{
  "pluginAlias": "KasaHub",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "email": {
        "title": "Email",
        "type": "string",
        "required": true,
        "description": "TPLink Tapo / Kasa account email."
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true,
        "description": "TPLink Tapo / Kasa account password"
      },
      "ignore_sensor": {
        "title": "Ignore sensors",
        "type": "boolean",
        "default": false,
        "required": false,
        "description": "Ignore temperature / humidity sensors"
      },
      "devices": {
        "title": "Hubs",
        "required": true,
        "uniqueItems": true,
        "type": "array",
        "description": "The IP addresses and the names for your TPLink Tapo / Kasa Hubs",
        "add": "Add",
        "items": {
          "title": "Hub IP",
          "type": "string",
          "required": true,
          "format": "ipv4",
          "minLength": 1
        }
      },
      "poll_interval": {
        "title": "Polling interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 5,
        "required": false,
        "description": "How often to poll devices for state updates. Lower values increase responsiveness but also network load."
      }
    }
  }
}